title: Toys

\procedure toy-listing(category)
<div class="jermolene-toy-listing">

<$list filter="[tag[toy]category<category>sort[caption]]">

<div class="jermolene-toy">

<$list filter="[all[current]has[screenshot]]" variable="ignore">

<a href={{!!url}} class="jermolene-screenshot-link" tabindex="-1" aria-hidden="true">

<img src={{!!screenshot}} alt="" width="1200" height="800" loading="lazy"/>

</a>

</$list>

<div class="jermolene-toy-text">

!!! <a href={{!!url}}><$view field="caption"/></a>

<$list filter="[all[current]has[description]]" variable="ignore">

<div class="jermolene-toy-description">

<$view field="description"/>

</div>

</$list>

</div>

</div>

</$list>

</div>
\end

