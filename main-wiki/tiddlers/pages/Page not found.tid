title: Page not found

\procedure directory(filter)
<ul class="jermolene-directory">
<$list filter=<<filter>>>
<li><a href={{{ [<currentTiddler>subfilter{$:/config/static/route-filter}addprefix[/]addsuffix[/]] }}}><$transclude field="caption"><$view field="title"/></$transclude></a></li>
</$list>
</ul>
\end

\procedure toy-directory(category)
<ul class="jermolene-directory">
<$list filter="[tag[toy]category<category>sort[caption]]">
<li><a href={{!!url}}><$view field="caption"/></a></li>
</$list>
</ul>
\end

